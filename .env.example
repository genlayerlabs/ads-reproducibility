# OpenAI-compatible Unhardcoded router. The public pilot endpoint is not a secret.
LLM_BASE_URL=https://router.ygr.ai/v1

# Consumer bearer token. Never commit the real value.
LLM_API_KEY=

# Alias used by Unhardcoded/OpenCode setups; either variable is sufficient.
UNHARDCODED_API_KEY=

# Optional local override of the manifest's request timeout.
ADS_LLM_TIMEOUT_SECONDS=90
